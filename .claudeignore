# ============================================================
# .claudeignore — UNIVERSO (raíz)
# Aplica a todos los mundos. Cada mundo puede añadir el suyo.
# ============================================================

# Dependencias
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
build/
.next/
out/
.vercel/
.output/

# Testing
coverage/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__/
__mocks__/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment (nunca exponer secrets)
.env*
!.env.example

# IDEs
.vscode/
.idea/
.qodo/
*.swp

# Cache
.cache/
.parcel-cache/
.turbo/
.eslintcache


# Assets pesados (descomenta si aplica)
# public/videos/
# *.mp4
# *.mov

# Docs generadas
docs/

#Folders
README.md
iniciar_claude_code.ps1
iniciar_opencode.ps1
TASKS.md
AGENTS.md
COWORK.md
opencode.json
# Archivos temporales
*.tmp
*.temp
# Claude config (lazy loading)
.claude/CONVENTIONS.md
.claude/ARCHITECTURE.md
.claude/agents.manifest.txt
.claude/commands.manifest.txt
