{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["../../AGENTS.md"],
  "mcp": {
    "semgrep": {
      "type": "remote",
      "url": "https://mcp.semgrep.ai/mcp"
    },
    "glitchtip": {
      "type": "remote",
      "url": "https://glitchtip.ladderdev.com/mcp"
    },
    "umami": {
      "type": "local",
      "command": ["npx", "-y", "@mikusnuz/umami-mcp"],
      "environment": {
        "UMAMI_URL": "${UMAMI_URL}",
        "UMAMI_USERNAME": "${UMAMI_USERNAME}",
        "UMAMI_PASSWORD": "${UMAMI_PASSWORD}"
      }
    },
    "pagespeed": {
      "type": "local",
      "command": ["npx", "-y", "mcp-server-pagespeed"],
      "environment": {
        "PAGESPEED_API_KEY": "${PAGESPEED_API_KEY}"
      }
    },
    "playwright-edge": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "msedge"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}
